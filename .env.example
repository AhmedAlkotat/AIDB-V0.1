# Build-time configuration of the frontend (Vite). Copy to .env.local (ignored by Git) to change it.
# There are NO secrets here: tokens and credentials are never configured or stored in the frontend.

# Which services the application uses:
#   mock  development only: the in-browser simulations (src/dev/). Refused by production builds.
#   http  the real HTTP API (docs/api/openapi.draft.yaml is the PROPOSED contract).
# Not set: `npm run dev` uses mock, a production build uses http. An unknown value stops the application with a message.
# VITE_API_MODE=mock

# Where the HTTP API lives: a path on the same origin, or an absolute http(s) URL. Not set: /api/v1
# Example with the development contract server (npm run contract-server):
# VITE_API_MODE=http
# VITE_API_BASE_URL=http://127.0.0.1:5301/api/v1
# VITE_API_BASE_URL=/api/v1
